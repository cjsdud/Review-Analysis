# ===== 서버 =====
PORT=4000

# 프론트엔드 주소 (CORS 허용)
CLIENT_ORIGIN=http://localhost:5173

# ===== 업로드 제한 =====
MAX_UPLOAD_BYTES=10485760

# ===== 데이터베이스 =====
DB_PATH=./data/app.db
UPLOAD_ROWS_TTL_MIN=60

# ===== AI / LLM =====
# LLM_PROVIDER: mock | openai | gemini | claude
LLM_PROVIDER=mock

# provider별 API KEY
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 공통 API KEY, provider별 키가 없을 때 사용
LLM_API_KEY=

# 모델명. 비워두면 provider별 기본값 사용
LLM_MODEL=

# LLM 호출 타임아웃(ms)
LLM_TIMEOUT_MS=20000

# 구버전 호환
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
