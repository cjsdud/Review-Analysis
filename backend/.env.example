# ===== 서버 =====
PORT=4000
# 프론트엔드 주소 (CORS 허용)
CLIENT_ORIGIN=http://localhost:5173

# ===== 업로드 제한 =====
# 업로드 파일 최대 크기 (바이트). 기본 10MB
MAX_UPLOAD_BYTES=10485760

# ===== 데이터베이스 =====
# SQLite 파일 경로 (MVP). 비워두면 ./data/app.db
DB_PATH=./data/app.db

# 업로드 파싱 rows 보관 시간(분). 이 시간이 지나면 rows를 비워 PII 잔존을 줄입니다.
UPLOAD_ROWS_TTL_MIN=60

# ===== AI / LLM =====
# LLM_PROVIDER: mock | openai | gemini | claude
# 키가 없거나 호출/파싱이 실패하면 자동으로 mock 응답으로 fallback 합니다.
LLM_PROVIDER=mock

# provider별 키 (해당 provider 선택 시 필요). LLM_API_KEY로 공통 지정도 가능.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# 모델 (미지정 시 provider 기본값: openai=gpt-4o-mini, gemini=gemini-1.5-flash, claude=claude-sonnet-4-6)
LLM_MODEL=

# LLM 호출 타임아웃(ms). 초과 시 mock fallback
LLM_TIMEOUT_MS=20000

# (구버전 호환) AI_PROVIDER / AI_API_KEY / AI_MODEL 도 인식됩니다.
