# ===== 서버 =====
PORT=4000
# 프론트엔드 주소 (CORS 허용)
CLIENT_ORIGIN=http://localhost:5173

# ===== 업로드 제한 =====
# 업로드 파일 최대 크기 (바이트). 기본 10MB
MAX_UPLOAD_BYTES=10485760

# ===== 데이터베이스 =====
# SQLite 파일 경로 (MVP). 비워두면 ./data/app.db
DB_PATH=./data/app.db

# ===== AI =====
# AI_PROVIDER: mock | openai | gemini | claude
# 키가 없거나 mock 이면 mock 응답으로 동작합니다.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
