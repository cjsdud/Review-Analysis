# ===== 서버 =====
PORT=4000

# 프론트엔드 주소 (CORS 허용)
CLIENT_ORIGIN=http://localhost:5173

# ===== 업로드 제한 =====
MAX_UPLOAD_BYTES=10485760

# ===== 인증 (auth) =====
# JWT 서명 비밀키. 운영 환경에서는 반드시 강력한 임의값으로 교체할 것.
AUTH_JWT_SECRET=change-me-please-change-this-in-production
# httpOnly cookie 이름
AUTH_COOKIE_NAME=reviewfit_token
# 토큰 만료 (예: 1h / 7d / 30d)
AUTH_TOKEN_EXPIRES_IN=7d
# true 면 미인증 요청도 데모 플로우로 허용. 운영에서는 반드시 false.
# 환경변수를 깜빡 잊었을 때 익명 접근이 열리지 않도록 기본값은 false.
DEMO_ALLOW_ANONYMOUS=false

# 관리자 이메일 목록 (쉼표 구분, 대소문자/공백 무시).
# 예: ADMIN_EMAILS=admin@example.com,owner@example.com
# 동작:
#   1) 서버 부팅 시: 해당 이메일을 가진 기존 사용자가 있으면 role='admin' 으로 보정.
#   2) 신규 회원가입 시: 해당 이메일이면 가입 즉시 role='admin' 으로 생성.
#   3) 로그인 시: 본인 이메일이 포함되어 있고 role 이 admin 이 아니면 즉시 보정.
# 운영에서는 최소 1개의 관리자 이메일을 설정하세요.
ADMIN_EMAILS=

# ===== 베타 테스트용 계정 seed =====
# Render Free 처럼 디스크가 휘발성인 환경에서 재배포/재시작 시 DB 가 초기화되어도
# 로그인 테스트와 관리자 접근이 바로 가능하도록 서버 시작 시 계정을 자동 생성합니다.
# 운영(Production)에서는 SEED_ACCOUNTS_ENABLED=false 를 권장합니다.
#
# 보안 주의:
#   - 비밀번호는 절대 코드에 하드코딩하지 마세요.
#   - 실제 비밀번호는 Render Environment Variables 에만 입력하세요.
#   - 비밀번호는 충분히 긴 임의 문자열(최소 8자, 권장 16자 이상)을 사용하세요.
#   - 베타 종료 후 SEED_ACCOUNTS_ENABLED=false 로 전환하세요.
SEED_ACCOUNTS_ENABLED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_TESTER_EMAIL=beta@example.com
SEED_TESTER_PASSWORD=change-this-beta-password

# SEED_ALLOW_PROMOTE_EXISTING (기본 true)
#   true  : SEED_ADMIN_EMAIL 과 같은 이메일로 이미 가입된 사용자가 있으면
#           해당 사용자를 admin 으로 자동 보정 (편의성↑, 위험↑).
#   false : 기존 사용자는 절대 admin 으로 올리지 않음 (운영 권장).
#           이미 다른 사람이 그 이메일로 가입돼 있으면 admin seed 는 skip.
SEED_ALLOW_PROMOTE_EXISTING=true

# SEED_RESET_PASSWORDS (기본 false)
#   true  : 부팅 시마다 seed 계정의 password_hash 를 env 값으로 재설정.
#           운영자가 비밀번호를 바꿔도 다음 재시작에 덮어쓰므로 일반적으로 false 유지.
#   false : seed 계정이 이미 있으면 비밀번호를 건드리지 않음.
SEED_RESET_PASSWORDS=false

# ※ SEED_ADMIN_EMAIL / SEED_TESTER_EMAIL 에 지정된 이메일은
#    SEED_ACCOUNTS_ENABLED 값과 관계없이 일반 회원가입이 차단됩니다.
#    (응답: 409 RESERVED_ACCOUNT_EMAIL — admin/tester 구분은 노출하지 않음)

# ===== 결제/사용량 (billing) =====
# true 면 플랜 월 분석 횟수/리뷰 수 제한이 실제로 차단된다. MVP/개발 중에는 false.
BILLING_ENFORCE_LIMITS=false

# ===== 데이터베이스 =====
# 로컬 개발(상대경로): 앱 폴더 내부.
DB_PATH=./data/app.db

# 운영 (Render Persistent Disk) 예시:
# DB_PATH=/var/data/reviewfit/app.db
# - Render 일반 파일시스템(예: /opt/render/project/src 내부)에 SQLite 를 두면
#   새 배포/재시작 시 데이터가 소실됩니다.
# - Render Persistent Disk 를 추가하고 mount path(예: /var/data) 안쪽을 DB_PATH 로 지정하세요.
# - 자세한 가이드: docs/render-deployment.md

# (선택) 백업 폴더 — 비우면 DB 파일과 같은 디렉터리의 backups/ 로 저장됩니다.
# DB_BACKUP_DIR=/var/data/reviewfit/backups

# 업로드 파싱 임시 데이터(rows / sheet_parse_results) 보관 시간(분). 기본 60, 최소 1.
UPLOAD_ROWS_TTL_MIN=60

# 임시 데이터 정리(cleanup) 주기(분). 기본 10, 최소 1.
UPLOAD_CLEANUP_INTERVAL_MIN=10

# ===== AI / LLM =====
# LLM_PROVIDER: mock | openai | gemini | claude
LLM_PROVIDER=mock

# provider별 API KEY
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 공통 API KEY, provider별 키가 없을 때 사용
LLM_API_KEY=

# 모델명. 비워두면 provider별 기본값 사용
LLM_MODEL=

# LLM 호출 타임아웃(ms)
LLM_TIMEOUT_MS=20000

# 구버전 호환
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ===== Google 로그인 =====
# Google Cloud Console > OAuth 2.0 Client ID (Application type: Web application).
# 미설정 시 /api/auth/google 은 503 GOOGLE_NOT_CONFIGURED 로 응답하고,
# 프론트는 GoogleLoginButton 을 자동으로 숨긴다.
# 설정 가이드: docs/google-login-setup.md
GOOGLE_CLIENT_ID=
